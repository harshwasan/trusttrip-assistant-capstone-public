# On AI Studio, use its assigned PORT and public preview origin. Do not copy
# these local values over platform settings. The fallback port is 3000.
PORT=3000
APP_ORIGIN=http://localhost:3000
# The server binds 0.0.0.0 by default for hosted containers. Use 127.0.0.1 for local-only runs.
HOST=0.0.0.0
# Number of reverse-proxy hops in front of the app, used to read the client IP for rate limits.
# 0 when the app is reached directly; 1 behind a single proxy such as Cloud Run / AI Studio hosting.
# Too high a value lets clients spoof their IP through X-Forwarded-For.
TRUST_PROXY=0
# Request limits for non-AI routes (per server instance, per minute).
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_IP_AI_PER_MINUTE=12
RATE_LIMIT_USER_READS_PER_MINUTE=60
RATE_LIMIT_USER_WRITES_PER_MINUTE=20
# Public Firebase web app configuration, entered from your own project settings.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIRESTORE_DATABASE_ID=(default)
# Use authorized Application Default Credentials in the hosting environment.
# GOOGLE_APPLICATION_CREDENTIALS may point to a securely stored local credential.
ENABLE_FIREBASE_ADMIN=false
# Select a currently available model from your own AI Studio account. No default is assumed.
GEMINI_MODEL=
GEMINI_API_KEY=
# Server-enforced model allowances. Days reset at 00:00 UTC (05:30 IST).
# Counts include failed outbound attempts. Zero disables the corresponding action.
AI_ENABLED=true
AI_CHAT_PER_MINUTE=5
AI_CHAT_PER_DAY=30
AI_ITINERARIES_PER_DAY=5
AI_GLOBAL_PER_DAY=200
# At most two explanation model attempts per trip; successful drafts are reused.
AI_EXPLANATIONS_PER_TRIP=2
AI_CHAT_MAX_OUTPUT_TOKENS=2048
AI_ITINERARY_MAX_OUTPUT_TOKENS=4096
AI_EXPLANATION_MAX_OUTPUT_TOKENS=512
AI_MAX_INPUT_CHARS=60000
# Explicitly enable only after authorizing the external setup.
ENABLE_AUTOMATION=false
# Total processing attempts per job, including Airtable/setup failures.
AUTOMATION_MAX_ATTEMPTS=5
# At least 32 random characters; automation stays disabled with a shorter token.
AUTOMATION_TOKEN=
N8N_WEBHOOK_URL=
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appV8g3WvLNKVEPom
